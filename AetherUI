function Window:_renderSearchResults(query)
	local results = self._selectedTab and self._selectedTab:_searchItems(query) or {}
	self._searchResultsHolder.Visible = #results > 0
	for _, child in ipairs(self._searchResultsHolder:GetChildren()) do
		if child:IsA("TextButton") then child:Destroy() end
	end
	local totalH = 0
	for i, item in ipairs(results) do
		local btn = create("TextButton", {
			Name = "R" .. i, LayoutOrder = i,
			Size = UDim2.new(1, 0, 0, self._metrics.Compact and 26 or 30),
			BackgroundColor3 = Theme.Element, BackgroundTransparency = 0.2,
			AutoButtonColor = false, Text = "", Parent = self._searchResultsHolder,
		})
		addCorner(btn, 6)
		create("TextLabel", {
			Name = "L", BackgroundTransparency = 1,
			Position = UDim2.fromOffset(8, 0), Size = UDim2.new(1, -16, 1, 0),
			Text = item.Text, Font = Theme.Font,
			TextSize = self._metrics.Text - 1, TextColor3 = Theme.SubText,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd, Parent = btn,
		})
		btn.MouseEnter:Connect(function()
			tween(btn, Anim.Fast, { BackgroundColor3 = Theme.ElementHover, BackgroundTransparency = 0 })
		end)
		btn.MouseLeave:Connect(function()
			tween(btn, Anim.Fast, { BackgroundColor3 = Theme.Element, BackgroundTransparency = 0.2 })
		end)
		btn.Activated:Connect(function()
			if item.Instance and item.Instance.Parent then
				self._selectedTab._page.CanvasPosition =
					Vector2.new(0, item.Instance.AbsolutePosition.Y
						- self._selectedTab._page.AbsolutePosition.Y
						+ self._selectedTab._page.CanvasPosition.Y - 20)
				local hl = create("Frame", {
					Size = UDim2.new(1, 0, 0, item.Instance.AbsoluteSize.Y),
					Position = UDim2.fromOffset(0, 0),
					BackgroundColor3 = accent(), BackgroundTransparency = 0.6,
					ZIndex = 9, Parent = item.Instance,
				})
				addCorner(hl, 8)
				tween(hl, 0.8, { BackgroundTransparency = 1 }).Completed:Connect(function()
					hl:Destroy()
				end)
			end
		end)
		totalH = totalH + btn.Size.Y.Offset + 2
	end
	self._searchResultsHolder.Size = UDim2.new(1, 0, 0, totalH)
	if self._searchResultsLayout then
		self._searchResultsLayout.Parent = nil
		self._searchResultsLayout.Parent = self._searchResultsHolder
	end
end

