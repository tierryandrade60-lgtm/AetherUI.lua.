--[[
	AetherUI v1.1.0
	UI Library minimalista para Roblox (Luau) - um unico ModuleScript.

	Recursos:
	  - Janela com titulo, botao X (fechar) e botao - (minimizar)
	  - Minimizar transforma a janela em uma bola flutuante arrastavel
	  - Clicar na bola reabre a janela com animacao
	  - Sistema de abas
	  - Componentes: Button, Toggle, Slider, Label, Section
	  - Responsivo (PC e mobile) e animado

	Uso: coloque este arquivo como ModuleScript (ex.: ReplicatedStorage.AetherUI)
	e chame-o a partir de um LocalScript. Exemplo no final do arquivo.
]]

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local TextService = game:GetService("TextService")
local Players = game:GetService("Players")

local AetherUI = {}
AetherUI.Version = "1.1.0"

local Window = {}
Window.__index = Window

local Tab = {}
Tab.__index = Tab

----------------------------------------------------------------
-- Tema e constantes
----------------------------------------------------------------
local Theme = {
	Background = Color3.fromRGB(18, 18, 24),
	Surface = Color3.fromRGB(26, 26, 34),
	Element = Color3.fromRGB(36, 36, 47),
	ElementHover = Color3.fromRGB(47, 47, 61),
	Off = Color3.fromRGB(64, 64, 82),
	Accent = Color3.fromRGB(124, 92, 255),
	AccentLight = Color3.fromRGB(166, 138, 255),
	Stroke = Color3.fromRGB(58, 58, 76),
	Text = Color3.fromRGB(240, 240, 248),
	SubText = Color3.fromRGB(150, 150, 168),
	Danger = Color3.fromRGB(235, 87, 87),
	White = Color3.fromRGB(255, 255, 255),
	Font = Enum.Font.GothamMedium,
	FontBold = Enum.Font.GothamBold,
}

local Anim = {
	Fast = 0.15,
	Normal = 0.25,
	Slow = 0.4,
}

----------------------------------------------------------------
-- Utilitarios
----------------------------------------------------------------
local function create(className, props, children)
	local instance = Instance.new(className)
	if instance:IsA("GuiObject") then
		instance.BorderSizePixel = 0
	end
	local parent = nil
	for key, value in pairs(props or {}) do
		if key == "Parent" then
			parent = value
		else
			instance[key] = value
		end
	end
	for _, child in ipairs(children or {}) do
		child.Parent = instance
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

local function tween(object, duration, properties, style, direction)
	local info = TweenInfo.new(
		duration,
		style or Enum.EasingStyle.Quint,
		direction or Enum.EasingDirection.Out
	)
	local t = TweenService:Create(object, info, properties)
	t:Play()
	return t
end

local function addCorner(parent, radius)
	return create("UICorner", { CornerRadius = UDim.new(0, radius), Parent = parent })
end

local function addPadding(parent, left, top, right, bottom)
	return create("UIPadding", {
		PaddingLeft = UDim.new(0, left),
		PaddingTop = UDim.new(0, top),
		PaddingRight = UDim.new(0, right),
		PaddingBottom = UDim.new(0, bottom),
		Parent = parent,
	})
end

local function addStroke(parent, color, transparency, thickness)
	return create("UIStroke", {
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Color = color or Theme.Stroke,
		Transparency = transparency or 0,
		Thickness = thickness or 1,
		Parent = parent,
	})
end

local function safeCall(callback, ...)
	if typeof(callback) ~= "function" then
		return
	end
	local ok, err = pcall(callback, ...)
	if not ok then
		warn("[AetherUI] Erro em callback: " .. tostring(err))
	end
end

local function isPointer(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch
end

local function getViewport()
	local camera = workspace.CurrentCamera
	if camera then
		return camera.ViewportSize
	end
	return Vector2.new(1280, 720)
end

local function getMetrics()
	local mobile = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	return {
		Mobile = mobile,
		Row = mobile and 42 or 36,
		Title = mobile and 44 or 40,
		TabBar = mobile and 42 or 36,
		Text = mobile and 15 or 14,
		Ball = mobile and 56 or 48,
		TitleButton = mobile and 32 or 28,
	}
end

local function getWindowSize()
	local viewport = getViewport()
	local width = math.clamp(math.floor(viewport.X * 0.92), 260, 520)
	local height = math.clamp(math.floor(viewport.Y * 0.78), 240, 360)
	width = math.min(width, math.max(math.floor(viewport.X) - 12, 200))
	height = math.min(height, math.max(math.floor(viewport.Y) - 12, 180))
	return UDim2.fromOffset(width, height)
end

local function textWidth(text, size, font)
	local ok, bounds = pcall(function()
		return TextService:GetTextSize(text, size, font, Vector2.new(1000, 100))
	end)
	if ok and bounds then
		return math.ceil(bounds.X)
	end
	return math.ceil(#text * size * 0.62)
end

local function bindCanvas(scroll, layout, axis, extra)
	local function update()
		local content = layout.AbsoluteContentSize
		if axis == "X" then
			scroll.CanvasSize = UDim2.fromOffset(content.X + extra, 0)
		else
			scroll.CanvasSize = UDim2.fromOffset(0, content.Y + extra)
		end
	end
	layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(update)
	update()
	return update
end

local function resolveParent()
	local ok, hidden = pcall(function()
		return gethui()
	end)
	if ok and typeof(hidden) == "Instance" then
		return hidden
	end
	local player = Players.LocalPlayer
	assert(player, "[AetherUI] CreateWindow deve ser chamado a partir de um LocalScript.")
	return player:WaitForChild("PlayerGui")
end

-- Mantem a janela inteira dentro da tela (posicao com AnchorPoint 0.5, 0.5).
local function clampWindowPosition(position, size)
	local viewport = getViewport()
	local halfW = size.X.Offset / 2
	local halfH = size.Y.Offset / 2
	local cx = position.X.Scale * viewport.X + position.X.Offset
	local cy = position.Y.Scale * viewport.Y + position.Y.Offset
	local nx = math.clamp(cx, math.min(halfW, viewport.X / 2), math.max(viewport.X - halfW, viewport.X / 2))
	local ny = math.clamp(cy, math.min(halfH, viewport.Y / 2), math.max(viewport.Y - halfH, viewport.Y / 2))
	return UDim2.new(
		position.X.Scale,
		position.X.Offset + (nx - cx),
		position.Y.Scale,
		position.Y.Offset + (ny - cy)
	)
end

-- Mantem a bola dentro da tela (posicao em offset, AnchorPoint 0.5, 0.5).
local function clampBallPosition(position, diameter)
	local viewport = getViewport()
	local r = diameter / 2 + 4
	return UDim2.fromOffset(
		math.clamp(position.X.Offset, r, math.max(viewport.X - r, r)),
		math.clamp(position.Y.Offset, r, math.max(viewport.Y - r, r))
	)
end

-- Arrasto generico (mouse e toque). Distingue clique de arrasto (limite de 5 px).
-- options: Clamp(position) -> position, OnClick(), OnDragEnd()
local function makeDraggable(handle, target, connections, options)
	options = options or {}
	local dragging = false
	local moved = false
	local activeInput = nil
	local startPointer = Vector2.zero
	local startPosition = target.Position

	table.insert(connections, handle.InputBegan:Connect(function(input)
		if dragging or not isPointer(input) then
			return
		end
		dragging = true
		moved = false
		activeInput = input
		startPointer = Vector2.new(input.Position.X, input.Position.Y)
		startPosition = target.Position
	end))

	table.insert(connections, UserInputService.InputChanged:Connect(function(input)
		if not dragging then
			return
		end
		local isMove = input.UserInputType == Enum.UserInputType.MouseMovement
			or (input.UserInputType == Enum.UserInputType.Touch and input == activeInput)
		if not isMove then
			return
		end
		local delta = Vector2.new(input.Position.X, input.Position.Y) - startPointer
		if not moved and delta.Magnitude < 5 then
			return
		end
		moved = true
		local newPosition = UDim2.new(
			startPosition.X.Scale,
			startPosition.X.Offset + delta.X,
			startPosition.Y.Scale,
			startPosition.Y.Offset + delta.Y
		)
		if options.Clamp then
			newPosition = options.Clamp(newPosition)
		end
		target.Position = newPosition
	end))

	table.insert(connections, UserInputService.InputEnded:Connect(function(input)
		if not dragging or not activeInput then
			return
		end
		local same = input == activeInput
			or (input.UserInputType == Enum.UserInputType.MouseButton1
				and activeInput.UserInputType == Enum.UserInputType.MouseButton1)
		if not same then
			return
		end
		dragging = false
		activeInput = nil
		if moved then
			if options.OnDragEnd then
				options.OnDragEnd()
			end
		elseif options.OnClick then
			options.OnClick()
		end
	end))
end

