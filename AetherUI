function Window:_selectTab(tab, animate)
	if self._selectedTab == tab then
		return
	end
	self._selectedTab = tab
	for _, other in ipairs(self._tabs) do
		local active = other == tab
		if not active then
			other._holder.Visible = false
		end
		tween(other._button, Anim.Fast, {
			BackgroundColor3 = active and Theme.Accent or Theme.Element,
			TextColor3 = active and Theme.Text or Theme.SubText,
		})
		tween(other._buttonStroke, Anim.Fast, {
			Transparency = active and 1 or 0.5,
		})
	end

	local holder = tab._holder
	holder.Visible = true
	tab:_refresh()
	if animate then
		holder.Position = UDim2.fromOffset(0, 12)
		holder.GroupTransparency = 1
		tween(holder, Anim.Normal, {
			Position = UDim2.fromOffset(0, 0),
			GroupTransparency = 0,
		})
	else
		holder.Position = UDim2.fromOffset(0, 0)
		holder.GroupTransparency = 0
	end
end

function Window:AddTab(name)
	local m = self._metrics
	local index = #self._tabs + 1
	local label = tostring(name or "Tab")

	local button = create("TextButton", {
		Name = "Tab_" .. tostring(name),
		LayoutOrder = index,
		Size = UDim2.fromOffset(textWidth(label, m.Text, Theme.Font) + 28, m.TabBar - 10),
		BackgroundColor3 = Theme.Element,
		AutoButtonColor = false,
		Text = label,
		Font = Theme.Font,
		TextSize = m.Text,
		TextColor3 = Theme.SubText,
		Parent = self._tabBar,
	})
	addCorner(button, 8)
	local buttonStroke = addStroke(button, Theme.Stroke, 0.5, 1)

	button.MouseEnter:Connect(function()
		if self._selectedTab and self._selectedTab._button == button then
			return
		end
		tween(button, Anim.Fast, { BackgroundColor3 = Theme.ElementHover })
	end)
	button.MouseLeave:Connect(function()
		if self._selectedTab and self._selectedTab._button == button then
			return
		end
		tween(button, Anim.Fast, { BackgroundColor3 = Theme.Element })
	end)

	local holder = create("CanvasGroup", {
		Name = "Page_" .. tostring(name),
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 1, 0),
		GroupTransparency = 1,
		Visible = false,
		Parent = self._content,
	})

	local page = create("ScrollingFrame", {
		Name = "Scroll",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 1, 0),
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.None,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = Theme.Accent,
		VerticalScrollBarInset = Enum.ScrollBarInset.None,
		Parent = holder,
	})
	addPadding(page, 10, 10, 10, 10)
	local layout = create("UIListLayout", {
		Padding = UDim.new(0, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = page,
	})

	local tab = setmetatable({
		_window = self,
		_page = page,
		_holder = holder,
		_button = button,
		_buttonStroke = buttonStroke,
		_metrics = m,
		_connections = self._connections,
		_order = 0,
	}, Tab)
	tab._updateCanvas = bindCanvas(page, layout, "Y", 20)

	table.insert(self._tabs, tab)

	button.Activated:Connect(function()
		self:_selectTab(tab, true)
	end)

	if index == 1 then
		self:_selectTab(tab, false)
	end

	return tab
end

function Window:SetTitle(text)
	if self._titleLabel then
		self._titleLabel.Text = tostring(text)
	end
end

function Window:_showBall()
	self._ball.Visible = true
	self._ballScale.Scale = 0
	tween(self._ballScale, Anim.Normal + 0.05, { Scale = 1 }, Enum.EasingStyle.Back)

	if self._pulse then
		self._pulse:Cancel()
	end
	self._ballStroke.Transparency = 0.7
	self._pulse = TweenService:Create(
		self._ballStroke,
		TweenInfo.new(1.1, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
		{ Transparency = 0.2 }
	)
	self._pulse:Play()
end

function Window:Minimize()
	if self._state ~= "Open" and self._state ~= "Opening" then
		return
	end
	self._state = "Minimizing"
	local root = self._root
	self._restorePosition = root.Position

	local duration = Anim.Normal + 0.1
	tween(root, duration, {
		Position = self._ball.Position,
		GroupTransparency = 1,
	}, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
	local t = tween(self._scale, duration, { Scale = 0.1 }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
	t.Completed:Connect(function(playbackState)
		if playbackState ~= Enum.PlaybackState.Completed or self._state ~= "Minimizing" then
			return
		end
		root.Visible = false
		self._state = "Minimized"
		self:_showBall()
	end)
end

function Window:Restore()
	if self._state ~= "Minimized" then
		return
	end
	self._state = "Restoring"
	local root = self._root
	local ballPosition = self._ball.Position

	if self._pulse then
		self._pulse:Cancel()
		self._pulse = nil
	end

	local t = tween(self._ballScale, Anim.Fast, { Scale = 0 }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
	t.Completed:Connect(function(playbackState)
		if playbackState ~= Enum.PlaybackState.Completed or self._state ~= "Restoring" then
			return
		end
		self._ball.Visible = false

		local size = getWindowSize()
		root.Size = size
		root.Position = ballPosition
		root.GroupTransparency = 1
		self._scale.Scale = 0.1
		root.Visible = true

		tween(root, Anim.Slow, {
			Position = clampWindowPosition(self._restorePosition, size),
			GroupTransparency = 0,
		})
		local t2 = tween(self._scale, Anim.Slow, { Scale = 1 }, Enum.EasingStyle.Back)
		t2.Completed:Connect(function(state2)
			if state2 == Enum.PlaybackState.Completed and self._state == "Restoring" then
				self._state = "Open"
			end
		end)
	end)
end

function Window:Close()
	if self._state == "Closing" or self._state == "Destroyed" then
		return
	end
	local wasHidden = not self._root.Visible
	self._state = "Closing"
	safeCall(self._onClose)

	if wasHidden then
		self:Destroy()
		return
	end

	tween(self._root, Anim.Normal, { GroupTransparency = 1 }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
	local t = tween(self._scale, Anim.Normal, { Scale = 0.85 }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
	t.Completed:Connect(function()
		self:Destroy()
	end)
end

function Window:Destroy()
	if self._state == "Destroyed" then
		return
	end
	self._state = "Destroyed"
	for _, connection in ipairs(self._connections) do
		connection:Disconnect()
	end
	table.clear(self._connections)
	if self._cameraConnection then
		self._cameraConnection:Disconnect()
		self._cameraConnection = nil
	end
	if self._pulse then
		self._pulse:Cancel()
		self._pulse = nil
	end
	if self._gui then
		self._gui:Destroy()
	end
end

function Window:_onViewportChanged()
	if self._state == "Destroyed" then
		return
	end
	if self._state == "Open" then
		local size = getWindowSize()
		tween(self._root, Anim.Normal, {
			Size = size,
			Position = clampWindowPosition(self._root.Position, size),
		})
	end
	self._ball.Position = clampBallPosition(self._ball.Position, self._metrics.Ball)
end

function Window:_bindCamera()
	if self._cameraConnection then
		self._cameraConnection:Disconnect()
		self._cameraConnection = nil
	end
	local camera = workspace.CurrentCamera
	if camera then
		self._cameraConnection = camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
			self:_onViewportChanged()
		end)
	end
end

