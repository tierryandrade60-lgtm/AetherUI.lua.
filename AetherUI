local function create(className, props, children)
	local instance = Instance.new(className)
	if instance:IsA("GuiObject") then
		instance.BorderSizePixel = 0
	end
	local parent = nil
	for key, value in pairs(props or {}) do
		if key == "Parent" then
			parent = value
		else
			instance[key] = value
		end
	end
	for _, child in ipairs(children or {}) do
		child.Parent = instance
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

local function instantTween()
	local stub = {}
	stub.Completed = {
		Connect = function(_, callback)
			task.defer(callback, Enum.PlaybackState.Completed)
			return { Disconnect = function() end }
		end,
	}
	function stub:Cancel() end
	function stub:Play() end
	return stub
end

local function tween(object, duration, properties, style, direction)
	if State.LowPerformance then
		for key, value in pairs(properties) do
			object[key] = value
		end
		return instantTween()
	end
	local info = TweenInfo.new(
		duration,
		style or Enum.EasingStyle.Quint,
		direction or Enum.EasingDirection.Out
	)
	local t = TweenService:Create(object, info, properties)
	t:Play()
	return t
end

local function setProps(object, properties, animate, duration)
	if animate then
		tween(object, duration or Anim.Fast, properties)
	else
		for key, value in pairs(properties) do
			object[key] = value
		end
	end
end

local function addCorner(parent, radius)
	return create("UICorner", { CornerRadius = UDim.new(0, radius), Parent = parent })
end

local function addCornerScale(parent, scale)
	return create("UICorner", { CornerRadius = UDim.new(scale, 0), Parent = parent })
end

local function addPadding(parent, left, top, right, bottom)
	return create("UIPadding", {
		PaddingLeft = UDim.new(0, left),
		PaddingTop = UDim.new(0, top),
		PaddingRight = UDim.new(0, right),
		PaddingBottom = UDim.new(0, bottom),
		Parent = parent,
	})
end

local function addStroke(parent, color, transparency, thickness)
	return create("UIStroke", {
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Color = color or Theme.Stroke,
		Transparency = transparency or 0,
		Thickness = thickness or 1,
		Parent = parent,
	})
end

local ShadowLayers = {
	{ Grow = 3, Alpha = 0.85 },
	{ Grow = 8, Alpha = 0.91 },
	{ Grow = 15, Alpha = 0.95 },
	{ Grow = 24, Alpha = 0.975 },
}

local function attachShadow(target, parent, corner, scaleObject, connections)
	local container = create("Frame", {
		Name = "Shadow",
		AnchorPoint = target.AnchorPoint,
		BackgroundTransparency = 1,
		ZIndex = 0,
		Parent = parent,
	})
	local containerScale = nil
	if scaleObject then
		containerScale = create("UIScale", { Parent = container })
	end
	local layers = {}
	for _, spec in ipairs(ShadowLayers) do
		local layer = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.new(1, spec.Grow * 2, 1, spec.Grow * 2),
			BackgroundColor3 = Theme.Black,
			BackgroundTransparency = spec.Alpha,
			Parent = container,
		})
		addCorner(layer, corner + spec.Grow)
		table.insert(layers, { Frame = layer, Alpha = spec.Alpha })
	end

	local function sync()
		local position = target.Position
		container.Position = UDim2.new(
			position.X.Scale,
			position.X.Offset,
			position.Y.Scale,
			position.Y.Offset + 6
		)
		container.Size = target.Size
		container.Visible = target.Visible and not State.LowPerformance
		if containerScale then
			containerScale.Scale = scaleObject.Scale
		end
		local groupTransparency = target.GroupTransparency
		for _, layer in ipairs(layers) do
			layer.Frame.BackgroundTransparency = 1 - (1 - layer.Alpha) * (1 - groupTransparency)
		end
	end

	local function watch(instance, property)
		local connection = instance:GetPropertyChangedSignal(property):Connect(sync)
		if connections then
			table.insert(connections, connection)
		end
	end

	watch(target, "Position")
	watch(target, "Size")
	watch(target, "Visible")
	watch(target, "GroupTransparency")
	if scaleObject then
		watch(scaleObject, "Scale")
	end
	sync()

	return { Instance = container, Sync = sync }
end

local function safeCall(callback, ...)
	if typeof(callback) ~= "function" then
		return
	end
	local ok, err = pcall(callback, ...)
	if not ok then
		warn("[AetherUI] Erro em callback: " .. tostring(err))
	end
end

local function isPointer(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch
end

local function colorsEqual(a, b)
	return math.abs(a.R - b.R) < 0.004
		and math.abs(a.G - b.G) < 0.004
		and math.abs(a.B - b.B) < 0.004
end

local function getViewport()
	local camera = workspace.CurrentCamera
	if camera then
		return camera.ViewportSize
	end
	return Vector2.new(1280, 720)
end

local function isMobile()
	return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
end

local function computeMetrics(compact)
	local mobile = isMobile()
	local c = compact == true
	local m = {}
	m.Mobile = mobile
	m.Compact = c
	m.Row = c and (mobile and 36 or 32) or (mobile and 44 or 38)
	m.Title = c and (mobile and 38 or 34) or (mobile and 46 or 42)
	m.Text = c and (mobile and 13 or 12) or (mobile and 15 or 14)
	m.Ball = c and (mobile and 46 or 40) or (mobile and 56 or 48)
	m.TitleButton = c and (mobile and 28 or 24) or (mobile and 32 or 28)
	m.Icon = c and 13 or (mobile and 17 or 16)
	m.SideRow = c and (mobile and 36 or 32) or (mobile and 42 or 38)
	m.SideWidth = c and (mobile and 108 or 116) or (mobile and 128 or 148)
	m.SidePad = 8
	m.SideGap = c and 3 or 4
	m.Pad = c and 10 or 12
	m.Gap = c and 7 or 9
	m.Header = c and 26 or 30
	m.SwitchW = c and 36 or 42
	m.SwitchH = c and 20 or 24
	m.Swatch = c and 22 or 26
	return m
end

local function getWindowSize(m)
	local viewport = getViewport()
	local width
	local height
	if m.Mobile then
		if m.Compact then
			width = math.clamp(math.floor(viewport.X * 0.5), 280, 380)
			height = math.clamp(math.floor(viewport.Y * 0.72), 200, 300)
		else
			width = math.clamp(math.floor(viewport.X * 0.6), 300, 460)
			height = math.clamp(math.floor(viewport.Y * 0.8), 220, 340)
		end
	else
		if m.Compact then
			width = math.clamp(math.floor(viewport.X * 0.36), 380, 460)
			height = math.clamp(math.floor(viewport.Y * 0.5), 260, 340)
		else
			width = math.clamp(math.floor(viewport.X * 0.46), 470, 600)
			height = math.clamp(math.floor(viewport.Y * 0.62), 320, 440)
		end
	end
	width = math.min(width, math.max(math.floor(viewport.X) - 12, 200))
	height = math.min(height, math.max(math.floor(viewport.Y) - 12, 180))
	return UDim2.fromOffset(width, height)
end

local function bindCanvas(scroll, layout, axis, extra)
	local function update()
		local content = layout.AbsoluteContentSize
		if axis == "X" then
			scroll.CanvasSize = UDim2.fromOffset(content.X + extra, 0)
		else
			scroll.CanvasSize = UDim2.fromOffset(0, content.Y + extra)
		end
	end
	layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(update)
	update()
	return update
end

local function resolveParent()
	local ok, hidden = pcall(function()
		return gethui()
	end)
	if ok and typeof(hidden) == "Instance" then
		return hidden
	end
	local player = Players.LocalPlayer
	assert(player, "[AetherUI] CreateWindow deve ser chamado a partir de um LocalScript.")
	return player:WaitForChild("PlayerGui")
end

local function clampWindowPosition(position, size)
	local viewport = getViewport()
	local halfW = size.X.Offset / 2
	local halfH = size.Y.Offset / 2
	local cx = position.X.Scale * viewport.X + position.X.Offset
	local cy = position.Y.Scale * viewport.Y + position.Y.Offset
	local nx = math.clamp(cx, math.min(halfW, viewport.X / 2), math.max(viewport.X - halfW, viewport.X / 2))
	local ny = math.clamp(cy, math.min(halfH, viewport.Y / 2), math.max(viewport.Y - halfH, viewport.Y / 2))
	return UDim2.new(
		position.X.Scale,
		position.X.Offset + (nx - cx),
		position.Y.Scale,
		position.Y.Offset + (ny - cy)
	)
end

local function clampBallPosition(position, diameter)
	local viewport = getViewport()
	local r = diameter / 2 + 4
	return UDim2.fromOffset(
		math.clamp(position.X.Offset, r, math.max(viewport.X - r, r)),
		math.clamp(position.Y.Offset, r, math.max(viewport.Y - r, r))
	)
end

local function makeDraggable(handle, target, connections, options)
	options = options or {}
	local dragging = false
	local moved = false
	local activeInput = nil
	local startPointer = Vector2.zero
	local startPosition = target.Position

	table.insert(connections, handle.InputBegan:Connect(function(input)
		if dragging or not isPointer(input) then
			return
		end
		dragging = true
		moved = false
		activeInput = input
		startPointer = Vector2.new(input.Position.X, input.Position.Y)
		startPosition = target.Position
	end))

	table.insert(connections, UserInputService.InputChanged:Connect(function(input)
		if not dragging then
			return
		end
		local isMove = input.UserInputType == Enum.UserInputType.MouseMovement
			or (input.UserInputType == Enum.UserInputType.Touch and input == activeInput)
		if not isMove then
			return
		end
		local delta = Vector2.new(input.Position.X, input.Position.Y) - startPointer
		if not moved and delta.Magnitude < 5 then
			return
		end
		moved = true
		local newPosition = UDim2.new(
			startPosition.X.Scale,
			startPosition.X.Offset + delta.X,
			startPosition.Y.Scale,
			startPosition.Y.Offset + delta.Y
		)
		if options.Clamp then
			newPosition = options.Clamp(newPosition)
		end
		target.Position = newPosition
	end))

	table.insert(connections, UserInputService.InputEnded:Connect(function(input)
		if not dragging or not activeInput then
			return
		end
		local same = input == activeInput
			or (input.UserInputType == Enum.UserInputType.MouseButton1
				and activeInput.UserInputType == Enum.UserInputType.MouseButton1)
		if not same then
			return
		end
		dragging = false
		activeInput = nil
		if moved then
			if options.OnDragEnd then
				options.OnDragEnd()
			end
		elseif options.OnClick then
			options.OnClick()
		end
	end))
end

