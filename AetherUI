-- config: Title (string), Name (string opcional), OnClose (function opcional)
function AetherUI.CreateWindow(config)
	config = config or {}

	local guiParent = resolveParent()
	local guiName = tostring(config.Name or "AetherUI")

	local previous = guiParent:FindFirstChild(guiName)
	if previous and previous:IsA("ScreenGui") then
		previous:Destroy()
	end

	local self = setmetatable({}, Window)
	local m = getMetrics()
	self._metrics = m
	self._connections = {}
	self._tabs = {}
	self._selectedTab = nil
	self._state = "Opening"
	self._onClose = config.OnClose

	local gui = create("ScreenGui", {
		Name = guiName,
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 1000,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = guiParent,
	})
	self._gui = gui

	-- Janela principal (CanvasGroup permite fade de todo o conteudo).
	local root = create("CanvasGroup", {
		Name = "Window",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = getWindowSize(),
		BackgroundColor3 = Theme.Background,
		GroupTransparency = 1,
		Parent = gui,
	})
	addCorner(root, 12)
	local rootScale = create("UIScale", { Scale = 0.85, Parent = root })
	self._root = root
	self._scale = rootScale

	-- Barra de titulo
	local titleBar = create("Frame", {
		Name = "TitleBar",
		Size = UDim2.new(1, 0, 0, m.Title),
		BackgroundColor3 = Theme.White,
		Parent = root,
	})
	create("UIGradient", {
		Color = ColorSequence.new(Color3.fromRGB(36, 36, 47), Theme.Surface),
		Rotation = 90,
		Parent = titleBar,
	})

	local titleDot = create("Frame", {
		Name = "Dot",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 14, 0.5, 0),
		Size = UDim2.fromOffset(8, 8),
		BackgroundColor3 = Theme.Accent,
		Parent = titleBar,
	})
	create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = titleDot })

	local buttonsWidth = m.TitleButton * 2 + 8 + 6 + 8
	local titleLabel = create("TextLabel", {
		Name = "Title",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(30, 0),
		Size = UDim2.new(1, -(buttonsWidth + 30), 1, 0),
		Text = tostring(config.Title or "AetherUI"),
		Font = Theme.FontBold,
		TextSize = m.Text + 2,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Active = true,
		Parent = titleBar,
	})
	self._titleLabel = titleLabel

	create("Frame", {
		Name = "Divider",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, 1),
		BackgroundColor3 = Theme.Element,
		Parent = titleBar,
	})

	local accentLine = create("Frame", {
		Name = "AccentLine",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, 1),
		BackgroundColor3 = Theme.White,
		Parent = titleBar,
	})
	create("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Theme.Accent),
			ColorSequenceKeypoint.new(0.5, Theme.AccentLight),
			ColorSequenceKeypoint.new(1, Theme.Accent),
		}),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.5, 0.1),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Parent = accentLine,
	})

	local function makeTitleButton(text, offsetX, hoverColor)
		local button = create("TextButton", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, offsetX, 0.5, 0),
			Size = UDim2.fromOffset(m.TitleButton, m.TitleButton - 4),
			BackgroundColor3 = Theme.Element,
			AutoButtonColor = false,
			Text = text,
			Font = Theme.FontBold,
			TextSize = m.Text + 1,
			TextColor3 = Theme.Text,
			Parent = titleBar,
		})
		addCorner(button, 6)
		local buttonScale = create("UIScale", { Parent = button })
		button.MouseEnter:Connect(function()
			tween(button, Anim.Fast, { BackgroundColor3 = hoverColor })
		end)
		button.MouseLeave:Connect(function()
			tween(button, Anim.Fast, { BackgroundColor3 = Theme.Element })
			tween(buttonScale, Anim.Fast, { Scale = 1 })
		end)
		button.MouseButton1Down:Connect(function()
			tween(buttonScale, 0.08, { Scale = 0.9 })
		end)
		button.MouseButton1Up:Connect(function()
			tween(buttonScale, Anim.Fast, { Scale = 1 }, Enum.EasingStyle.Back)
		end)
		return button
	end

	local closeButton = makeTitleButton("X", -8, Theme.Danger)
	local minimizeButton = makeTitleButton("-", -(8 + m.TitleButton + 6), Theme.ElementHover)

	closeButton.Activated:Connect(function()
		self:Close()
	end)
	minimizeButton.Activated:Connect(function()
		self:Minimize()
	end)

	-- Barra de abas (rolagem horizontal) e area de conteudo
	local tabBar = create("ScrollingFrame", {
		Name = "TabBar",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, m.Title),
		Size = UDim2.new(1, 0, 0, m.TabBar),
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.None,
		ScrollingDirection = Enum.ScrollingDirection.X,
		ScrollBarThickness = 0,
		Parent = root,
	})
	addPadding(tabBar, 10, 0, 10, 0)
	local tabLayout = create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = tabBar,
	})
	bindCanvas(tabBar, tabLayout, "X", 20)
	self._tabBar = tabBar

	local content = create("Frame", {
		Name = "Content",
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		Position = UDim2.fromOffset(0, m.Title + m.TabBar),
		Size = UDim2.new(1, 0, 1, -(m.Title + m.TabBar)),
		Parent = root,
	})
	self._content = content

	local border = create("Frame", {
		Name = "Border",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(1, 1),
		Size = UDim2.new(1, -2, 1, -2),
		ZIndex = 10,
		Active = false,
		Parent = root,
	})
	addCorner(border, 11)
	addStroke(border, Theme.Stroke, 0.35, 1)

	-- Bola flutuante (janela minimizada)
	local viewport = getViewport()
	local ball = create("TextButton", {
		Name = "Ball",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = clampBallPosition(UDim2.fromOffset(44, math.floor(viewport.Y * 0.3)), m.Ball),
		Size = UDim2.fromOffset(m.Ball, m.Ball),
		BackgroundColor3 = Theme.Accent,
		AutoButtonColor = false,
		Text = "A",
		Font = Theme.FontBold,
		TextSize = m.Ball * 0.45,
		TextColor3 = Theme.Text,
		Visible = false,
		Parent = gui,
	})
	create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = ball })
	self._ballStroke = create("UIStroke", {
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Color = Theme.AccentLight,
		Transparency = 0.7,
		Thickness = 2,
		Parent = ball,
	})
	self._ball = ball
	self._ballScale = create("UIScale", { Scale = 0, Parent = ball })

	-- Arrastar janela pelo titulo e bola pela tela (clique na bola = restaurar)
	makeDraggable(titleLabel, root, self._connections, {
		Clamp = function(position)
			return clampWindowPosition(position, root.Size)
		end,
	})
	makeDraggable(titleBar, root, self._connections, {
		Clamp = function(position)
			return clampWindowPosition(position, root.Size)
		end,
	})
	makeDraggable(ball, ball, self._connections, {
		Clamp = function(position)
			return clampBallPosition(position, m.Ball)
		end,
		OnClick = function()
			self:Restore()
		end,
	})

	-- Responsividade
	self:_bindCamera()
	table.insert(self._connections, workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
		self:_bindCamera()
		self:_onViewportChanged()
	end))

	-- Animacao de abertura
	tween(root, Anim.Normal + 0.05, { GroupTransparency = 0 })
	local openTween = tween(rootScale, Anim.Slow, { Scale = 1 }, Enum.EasingStyle.Back)
	openTween.Completed:Connect(function(playbackState)
		if playbackState == Enum.PlaybackState.Completed and self._state == "Opening" then
			self._state = "Open"
		end
	end)

	return self
end

return AetherUI

