function AetherUI.SetAccent(first, second)
	local color = first
	if first == AetherUI then
		color = second
	end
	if typeof(color) ~= "Color3" then
		return
	end
	State.Accent = color
	for _, window in ipairs(Windows) do
		window:_refreshAccent(true)
	end
end

function AetherUI.GetAccent()
	return State.Accent
end

function AetherUI.SetLowPerformance(first, second)
	local value = first
	if first == AetherUI then
		value = second
	end
	State.LowPerformance = value == true
	for _, window in ipairs(Windows) do
		window:_applyPerformance()
	end
end

function AetherUI.GetLowPerformance()
	return State.LowPerformance
end

-- config: Title (string), Name (string opcional), OnClose (function opcional),
-- Accent (Color3 opcional), Compact (bool opcional), SidebarCollapsed (bool opcional),
-- LowPerformance (bool opcional), Settings (false remove a aba "Interface")
function AetherUI.CreateWindow(config)
	config = config or {}

	if typeof(config.Accent) == "Color3" then
		AetherUI.SetAccent(config.Accent)
	end
	if config.LowPerformance ~= nil then
		AetherUI.SetLowPerformance(config.LowPerformance)
	end

	local guiParent = resolveParent()
	local guiName = tostring(config.Name or "AetherUI")

	local previous = guiParent:FindFirstChild(guiName)
	if previous and previous:IsA("ScreenGui") then
		previous:Destroy()
	end

	local self = setmetatable({}, Window)
	self._compact = config.Compact == true
	local m = computeMetrics(self._compact)
	self._metrics = m
	self._connections = {}
	self._tabs = {}
	self._selectedTab = nil
	self._state = "Opening"
	self._onClose = config.OnClose
	self._layoutUpdaters = {}
	self._accentUpdaters = {}
	self._gradients = {}
	self._userTabs = 0
	self._collapsedManual = nil
	if config.SidebarCollapsed ~= nil then
		self._collapsedManual = config.SidebarCollapsed == true
	end
	self._collapsed = false
	self._syncing = false

	local gui = create("ScreenGui", {
		Name = guiName,
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 1000,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = guiParent,
	})
	self._gui = gui

	local root = create("CanvasGroup", {
		Name = "Window",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 10),
		Size = self:_getSize(),
		BackgroundColor3 = Theme.Background,
		GroupTransparency = 1,
		Parent = gui,
	})
	addCorner(root, 14)
	local rootScale = create("UIScale", { Scale = 0.94, Parent = root })
	self._root = root
	self._scale = rootScale
	self._shadow = attachShadow(root, gui, 14, rootScale, self._connections)

	local titleBar = create("Frame", {
		Name = "TitleBar",
		Size = UDim2.new(1, 0, 0, m.Title),
		BackgroundColor3 = Theme.Sidebar,
		Parent = root,
	})
	self._titleBar = titleBar

	local titleLabel = create("TextLabel", {
		Name = "Title",
		BackgroundTransparency = 1,
		Text = tostring(config.Title or "AetherUI"),
		Font = Theme.FontBold,
		TextSize = m.Text + 1,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Active = true,
		Parent = titleBar,
	})
	self._titleLabel = titleLabel

	create("Frame", {
		Name = "Divider",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, 1),
		BackgroundColor3 = Theme.Divider,
		Parent = titleBar,
	})

	local accentLine = create("Frame", {
		Name = "AccentLine",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, 1),
		BackgroundColor3 = accent(),
		Parent = titleBar,
	})
	local accentGradient = create("UIGradient", {
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.5, 0.15),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Parent = accentLine,
	})
	table.insert(self._gradients, accentGradient)

	local function makeTitleButton(iconName, hoverColor, hoverIconColor)
		local button = create("TextButton", {
			AnchorPoint = Vector2.new(1, 0.5),
			Size = UDim2.fromOffset(m.TitleButton, m.TitleButton),
			BackgroundColor3 = Theme.Element,
			BackgroundTransparency = 1,
			AutoButtonColor = false,
			Text = "",
			Parent = titleBar,
		})
		addCorner(button, 8)
		local buttonScale = create("UIScale", { Parent = button })
		local icon = createIcon(iconName, button, m.Icon - 2, Theme.SubText)
		icon.Instance.AnchorPoint = Vector2.new(0.5, 0.5)
		icon.Instance.Position = UDim2.fromScale(0.5, 0.5)
		button.MouseEnter:Connect(function()
			tween(button, Anim.Fast, { BackgroundTransparency = 0, BackgroundColor3 = hoverColor })
			icon:Tween(hoverIconColor, Anim.Fast)
		end)
		button.MouseLeave:Connect(function()
			tween(button, Anim.Fast, { BackgroundTransparency = 1 })
			icon:Tween(Theme.SubText, Anim.Fast)
			tween(buttonScale, Anim.Fast, { Scale = 1 })
		end)
		button.MouseButton1Down:Connect(function()
			tween(buttonScale, 0.08, { Scale = 0.9 })
		end)
		button.MouseButton1Up:Connect(function()
			tween(buttonScale, Anim.Fast, { Scale = 1 }, Enum.EasingStyle.Back)
		end)
		return button, icon
	end

	local closeButton, closeIcon = makeTitleButton("close", Theme.Danger, Theme.White)
	local minimizeButton, minimizeIcon = makeTitleButton("minus", Theme.ElementHover, Theme.Text)
	local menuButton, menuIcon = makeTitleButton("menu", Theme.ElementHover, Theme.Text)
	menuButton.AnchorPoint = Vector2.new(0, 0.5)
	self._closeButton = closeButton
	self._closeIcon = closeIcon
	self._minimizeButton = minimizeButton
	self._minimizeIcon = minimizeIcon
	self._menuButton = menuButton
	self._menuIcon = menuIcon

	closeButton.Activated:Connect(function()
		self:Close()
	end)
	minimizeButton.Activated:Connect(function()
		self:Minimize()
	end)
	menuButton.Activated:Connect(function()
		self:ToggleSidebar()
	end)

	local body = create("Frame", {
		Name = "Body",
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		Position = UDim2.fromOffset(0, m.Title),
		Size = UDim2.new(1, 0, 1, -m.Title),
		Parent = root,
	})
	self._body = body

	local sidebar = create("Frame", {
		Name = "Sidebar",
		BackgroundColor3 = Theme.Sidebar,
		ClipsDescendants = true,
		Size = UDim2.new(0, m.SideWidth, 1, 0),
		Parent = body,
	})
	self._sidebar = sidebar

	create("Frame", {
		Name = "Divider",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.new(0, 1, 1, 0),
		BackgroundColor3 = Theme.Divider,
		ZIndex = 5,
		Parent = sidebar,
	})

	local list = create("ScrollingFrame", {
		Name = "Tabs",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -1, 1, 0),
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.None,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ScrollBarThickness = 0,
		Parent = sidebar,
	})
	self._list = list
	self._listPadding = addPadding(list, m.SidePad, 8, m.SidePad, 8)

	self._separator = create("Frame", {
		Name = "Separator",
		BackgroundColor3 = Theme.Divider,
		Size = UDim2.new(1, -8, 0, 1),
		Visible = false,
		Parent = list,
	})

	self._highlight = create("Frame", {
		Name = "Highlight",
		BackgroundColor3 = accentSoft(0.16),
		Size = UDim2.new(1, 0, 0, m.SideRow),
		ZIndex = 1,
		Visible = false,
		Parent = list,
	})
	addCorner(self._highlight, 10)
	self._highlightStroke = addStroke(self._highlight, accent(), 0.82, 1)

	self._indicator = create("Frame", {
		Name = "Indicator",
		BackgroundColor3 = accent(),
		Size = UDim2.fromOffset(3, 12),
		ZIndex = 3,
		Visible = false,
		Parent = list,
	})
	addCornerScale(self._indicator, 0.5)

	local content = create("Frame", {
		Name = "Content",
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		Position = UDim2.fromOffset(m.SideWidth, 0),
		Size = UDim2.new(1, -m.SideWidth, 1, 0),
		Parent = body,
	})
	self._content = content

	self._header = create("TextLabel", {
		Name = "Header",
		BackgroundTransparency = 1,
		Text = "",
		Font = Theme.FontBold,
		TextSize = m.Text + 3,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = content,
	})

	self._pages = create("Frame", {
		Name = "Pages",
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		Parent = content,
	})

	local border = create("Frame", {
		Name = "Border",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(1, 1),
		Size = UDim2.new(1, -2, 1, -2),
		ZIndex = 10,
		Active = false,
		Parent = root,
	})
	addCorner(border, 13)
	addStroke(border, Theme.Stroke, 0.25, 1)

	local viewport = getViewport()
	local ball = create("TextButton", {
		Name = "Ball",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = clampBallPosition(UDim2.fromOffset(44, math.floor(viewport.Y * 0.3)), m.Ball),
		Size = UDim2.fromOffset(m.Ball, m.Ball),
		BackgroundColor3 = Theme.Surface,
		AutoButtonColor = false,
		Text = "A",
		Font = Theme.FontBold,
		TextSize = math.floor(m.Ball * 0.45),
		TextColor3 = accentLight(),
		Visible = false,
		Parent = gui,
	})
	addCornerScale(ball, 0.5)
	self._ballStroke = create("UIStroke", {
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Color = accentLight(),
		Transparency = 0.7,
		Thickness = 2,
		Parent = ball,
	})
	self._ball = ball
	self._ballScale = create("UIScale", { Scale = 0, Parent = ball })
	ball.MouseEnter:Connect(function()
		if self._state == "Minimized" then
			tween(self._ballScale, Anim.Fast, { Scale = 1.08 })
		end
	end)
	ball.MouseLeave:Connect(function()
		if self._state == "Minimized" then
			tween(self._ballScale, Anim.Fast, { Scale = 1 })
		end
	end)

	makeDraggable(titleLabel, root, self._connections, {
		Clamp = function(position)
			return clampWindowPosition(position, root.Size)
		end,
	})
	makeDraggable(titleBar, root, self._connections, {
		Clamp = function(position)
			return clampWindowPosition(position, root.Size)
		end,
	})
	makeDraggable(ball, ball, self._connections, {
		Clamp = function(position)
			return clampBallPosition(position, self._metrics.Ball)
		end,
		OnClick = function()
			self:Restore()
		end,
	})

	self:_onAccent(function(animate)
		setProps(self._highlight, { BackgroundColor3 = accentSoft(0.16) }, animate, Anim.Normal)
		setProps(self._highlightStroke, { Color = accent() }, animate, Anim.Normal)
		setProps(self._indicator, { BackgroundColor3 = accent() }, animate, Anim.Normal)
		accentLine.BackgroundColor3 = accent()
		ball.TextColor3 = accentLight()
		self._ballStroke.Color = accentLight()
	end)

	self:_applyLayout(false)

	if config.Settings ~= false then
		self:_buildSettings()
	end

	self:_applyLayout(false)
	self:_applyPerformance()

	self:_bindCamera()
	table.insert(self._connections, workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
		self:_bindCamera()
		self:_onViewportChanged()
	end))

	table.insert(Windows, self)

	tween(root, Anim.Normal + 0.05, { GroupTransparency = 0 })
	tween(root, Anim.Slow + 0.1, { Position = UDim2.fromScale(0.5, 0.5) })
	local openTween = tween(rootScale, Anim.Slow + 0.1, { Scale = 1 })
	openTween.Completed:Connect(function(playbackState)
		if playbackState == Enum.PlaybackState.Completed and self._state == "Opening" then
			self._state = "Open"
		end
	end)

	return self
end

return AetherUI

