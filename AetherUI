function Tab:AddButton(config)
	config = config or {}
	local win = self._window
	local m = self._metrics

	local button = create("TextButton", {
		Name = "Button",
		LayoutOrder = self:_nextOrder(),
		Size = UDim2.new(1, 0, 0, m.Row),
		BackgroundColor3 = Theme.Element,
		AutoButtonColor = false,
		Text = config.Name or "Button",
		Font = Theme.Font,
		TextSize = m.Text,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = self._page,
	})
	addCorner(button, 10)
	local stroke = addStroke(button, Theme.Stroke, 0.35, 1)
	local scale = create("UIScale", { Parent = button })
	local padding = addPadding(button, 14, 0, 14, 0)

	local lead = createIcon(config.Icon, button, m.Icon, Theme.SubText)
	if lead then
		lead.Instance.AnchorPoint = Vector2.new(0, 0.5)
	end
	local chevron = createIcon("chevron-right", button, m.Icon - 2, Theme.Muted)
	chevron.Instance.AnchorPoint = Vector2.new(1, 0.5)

	win:_onLayout(function()
		button.Size = UDim2.new(1, 0, 0, m.Row)
		button.TextSize = m.Text
		local leadExtra = 0
		if lead then
			lead:SetSize(m.Icon)
			leadExtra = m.Icon + 10
			lead.Instance.Position = UDim2.new(0, -leadExtra, 0.5, 0)
		end
		chevron:SetSize(m.Icon - 2)
		local chevronExtra = (m.Icon - 2) + 8
		chevron.Instance.Position = UDim2.new(1, chevronExtra, 0.5, 0)
		padding.PaddingLeft = UDim.new(0, 14 + leadExtra)
		padding.PaddingRight = UDim.new(0, 14 + chevronExtra)
	end)

	local hovering = false
	button.MouseEnter:Connect(function()
		hovering = true
		tween(button, Anim.Fast, { BackgroundColor3 = Theme.ElementHover })
		tween(stroke, Anim.Fast, { Color = accent(), Transparency = 0.6 })
		chevron:Tween(accentLight(), Anim.Fast)
		if lead then
			lead:Tween(Theme.Text, Anim.Fast)
		end
	end)
	button.MouseLeave:Connect(function()
		hovering = false
		tween(button, Anim.Fast, { BackgroundColor3 = Theme.Element })
		tween(stroke, Anim.Fast, { Color = Theme.Stroke, Transparency = 0.35 })
		tween(scale, Anim.Fast, { Scale = 1 })
		chevron:Tween(Theme.Muted, Anim.Fast)
		if lead then
			lead:Tween(Theme.SubText, Anim.Fast)
		end
	end)
	button.MouseButton1Down:Connect(function()
		tween(button, 0.08, { BackgroundColor3 = accentSoft(0.3) })
		tween(scale, 0.08, { Scale = 0.98 })
	end)
	button.MouseButton1Up:Connect(function()
		tween(button, Anim.Fast, { BackgroundColor3 = hovering and Theme.ElementHover or Theme.Element })
		tween(scale, Anim.Fast, { Scale = 1 }, Enum.EasingStyle.Back)
	end)
	button.Activated:Connect(function()
		safeCall(config.Callback)
	end)

	local object = { Instance = button }

	function object:SetText(newText)
		button.Text = tostring(newText)
	end

	return object
end

function Tab:AddToggle(config)
	config = config or {}
	local win = self._window
	local m = self._metrics
	local state = config.Default == true

	local row = create("TextButton", {
		Name = "Toggle",
		LayoutOrder = self:_nextOrder(),
		Size = UDim2.new(1, 0, 0, m.Row),
		BackgroundColor3 = Theme.Element,
		AutoButtonColor = false,
		Text = "",
		Parent = self._page,
	})
	addCorner(row, 10)
	local stroke = addStroke(row, Theme.Stroke, 0.35, 1)

	local lead = createIcon(config.Icon, row, m.Icon, Theme.SubText)
	if lead then
		lead.Instance.AnchorPoint = Vector2.new(0, 0.5)
		lead.Instance.Position = UDim2.new(0, 14, 0.5, 0)
	end

	local label = create("TextLabel", {
		Name = "Label",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(14, 0),
		Size = UDim2.new(1, -70, 1, 0),
		Text = config.Name or "Toggle",
		Font = Theme.Font,
		TextSize = m.Text,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = row,
	})

	local switch = create("Frame", {
		Name = "Switch",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14, 0.5, 0),
		Size = UDim2.fromOffset(m.SwitchW, m.SwitchH),
		BackgroundColor3 = state and accent() or Theme.Off,
		Parent = row,
	})
	addCornerScale(switch, 0.5)

	local knob = create("Frame", {
		Name = "Knob",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 3, 0.5, 0),
		Size = UDim2.fromOffset(m.SwitchH - 6, m.SwitchH - 6),
		BackgroundColor3 = Theme.White,
		Parent = switch,
	})
	addCornerScale(knob, 0.5)

	local function knobPosition()
		if state then
			return UDim2.new(1, -((m.SwitchH - 6) + 3), 0.5, 0)
		end
		return UDim2.new(0, 3, 0.5, 0)
	end

	local function render(animate)
		local props = {
			BackgroundColor3 = state and accent() or Theme.Off,
		}
		setProps(switch, props, animate, Anim.Normal)
		if animate then
			tween(knob, Anim.Normal, { Position = knobPosition() })
		else
			knob.Position = knobPosition()
		end
		setProps(stroke, {
			Color = state and accent() or Theme.Stroke,
			Transparency = state and 0.5 or 0.35,
		}, animate, Anim.Normal)
		if lead then
			if animate then
				lead:Tween(state and accentLight() or Theme.SubText, Anim.Normal)
			else
				lead:SetColor(state and accentLight() or Theme.SubText)
			end
		end
	end

	win:_onLayout(function()
		row.Size = UDim2.new(1, 0, 0, m.Row)
		label.TextSize = m.Text
		local leftX = 14
		if lead then
			lead:SetSize(m.Icon)
			leftX = 14 + m.Icon + 10
		end
		label.Position = UDim2.fromOffset(leftX, 0)
		label.Size = UDim2.new(1, -(leftX + m.SwitchW + 28), 1, 0)
		switch.Size = UDim2.fromOffset(m.SwitchW, m.SwitchH)
		knob.Size = UDim2.fromOffset(m.SwitchH - 6, m.SwitchH - 6)
		knob.Position = knobPosition()
	end)

	win:_onAccent(function(animate)
		render(animate)
	end)

	local object = { Instance = row }

	function object:Set(value)
		value = value == true
		if value == state then
			return
		end
		state = value
		render(true)
		safeCall(config.Callback, state)
	end

	function object:Get()
		return state
	end

	function object:SetText(newText)
		label.Text = tostring(newText)
	end

	local rowScale = create("UIScale", { Parent = row })
	row.MouseEnter:Connect(function()
		tween(row, Anim.Fast, { BackgroundColor3 = Theme.ElementHover })
	end)
	row.MouseLeave:Connect(function()
		tween(row, Anim.Fast, { BackgroundColor3 = Theme.Element })
		tween(rowScale, Anim.Fast, { Scale = 1 })
	end)
	row.MouseButton1Down:Connect(function()
		tween(rowScale, 0.08, { Scale = 0.985 })
	end)
	row.MouseButton1Up:Connect(function()
		tween(rowScale, Anim.Fast, { Scale = 1 }, Enum.EasingStyle.Back)
	end)
	row.Activated:Connect(function()
		object:Set(not state)
	end)

	return object
end

function Tab:AddSlider(config)
	config = config or {}
	local win = self._window
	local m = self._metrics
	local min = config.Min or 0
	local max = config.Max or 100
	if max < min then
		min, max = max, min
	end
	local step = config.Step or 1
	local suffix = config.Suffix or ""

	local function snap(v)
		v = math.clamp(v, min, max)
		if step > 0 then
			v = min + math.floor((v - min) / step + 0.5) * step
		end
		v = math.clamp(v, min, max)
		return math.floor(v * 10000 + 0.5) / 10000
	end

	local value = snap(config.Default or min)

	local holder = create("Frame", {
		Name = "Slider",
		LayoutOrder = self:_nextOrder(),
		Size = UDim2.new(1, 0, 0, m.Row + 14),
		BackgroundColor3 = Theme.Element,
		Parent = self._page,
	})
	addCorner(holder, 10)
	addStroke(holder, Theme.Stroke, 0.35, 1)

	local lead = createIcon(config.Icon, holder, m.Icon, Theme.SubText)
	if lead then
		lead.Instance.AnchorPoint = Vector2.new(0, 0.5)
		lead.Instance.Position = UDim2.new(0, 14, 0, 17)
	end

	local nameLabel = create("TextLabel", {
		Name = "Label",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(14, 8),
		Size = UDim2.new(1, -96, 0, 18),
		Text = config.Name or "Slider",
		Font = Theme.Font,
		TextSize = m.Text,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = holder,
	})

	local valueLabel = create("TextLabel", {
		Name = "Value",
		AnchorPoint = Vector2.new(1, 0),
		BackgroundTransparency = 1,
		Position = UDim2.new(1, -14, 0, 8),
		Size = UDim2.fromOffset(70, 18),
		Text = "",
		Font = Theme.Font,
		TextSize = m.Text,
		TextColor3 = Theme.SubText,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = holder,
	})

	local track = create("Frame", {
		Name = "Track",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 1, -16),
		Size = UDim2.new(1, -28, 0, 5),
		BackgroundColor3 = Theme.Off,
		Parent = holder,
	})
	addCornerScale(track, 0.5)

	local fill = create("Frame", {
		Name = "Fill",
		Size = UDim2.new(0, 0, 1, 0),
		BackgroundColor3 = accent(),
		Parent = track,
	})
	addCornerScale(fill, 0.5)

	local function knobBase()
		return m.Compact and 12 or 14
	end

	local knob = create("Frame", {
		Name = "Knob",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.fromOffset(knobBase(), knobBase()),
		BackgroundColor3 = Theme.White,
		ZIndex = 2,
		Parent = track,
	})
	addCornerScale(knob, 0.5)
	local knobHalo = create("UIStroke", {
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Color = accent(),
		Thickness = 3,
		Transparency = 1,
		Parent = knob,
	})

	local hit = create("TextButton", {
		Name = "Hit",
		AnchorPoint = Vector2.new(0, 1),
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, 34),
		Text = "",
		AutoButtonColor = false,
		ZIndex = 3,
		Parent = holder,
	})

	local function render(animate)
		local alpha = 0
		if max > min then
			alpha = (value - min) / (max - min)
		end
		valueLabel.Text = tostring(value) .. suffix
		if animate then
			tween(fill, 0.06, { Size = UDim2.new(alpha, 0, 1, 0) }, Enum.EasingStyle.Linear)
			tween(knob, 0.06, { Position = UDim2.new(alpha, 0, 0.5, 0) }, Enum.EasingStyle.Linear)
		else
			fill.Size = UDim2.new(alpha, 0, 1, 0)
			knob.Position = UDim2.new(alpha, 0, 0.5, 0)
		end
	end

	local dragging = false

	win:_onLayout(function()
		holder.Size = UDim2.new(1, 0, 0, m.Row + 14)
		nameLabel.TextSize = m.Text
		valueLabel.TextSize = m.Text
		local leftX = 14
		if lead then
			lead:SetSize(m.Icon)
			leftX = 14 + m.Icon + 10
		end
		nameLabel.Position = UDim2.fromOffset(leftX, 8)
		nameLabel.Size = UDim2.new(1, -(leftX + 82), 0, 18)
		local size = dragging and (knobBase() + 4) or knobBase()
		knob.Size = UDim2.fromOffset(size, size)
		render(false)
	end)

	win:_onAccent(function(animate)
		setProps(fill, { BackgroundColor3 = accent() }, animate, Anim.Normal)
		setProps(knobHalo, { Color = accent() }, animate, Anim.Normal)
		if dragging then
			valueLabel.TextColor3 = accentLight()
		end
	end)

	local object = { Instance = holder }

	function object:Set(newValue)
		newValue = snap(newValue)
		if newValue == value then
			return
		end
		value = newValue
		render(true)
		safeCall(config.Callback, value)
	end

	function object:Get()
		return value
	end

	local function updateFromInput(input)
		local width = track.AbsoluteSize.X
		if width <= 0 then
			return
		end
		local alpha = math.clamp((input.Position.X - track.AbsolutePosition.X) / width, 0, 1)
		object:Set(min + (max - min) * alpha)
	end

	local function stopDragging()
		if not dragging then
			return
		end
		dragging = false
		self._page.ScrollingEnabled = true
		tween(knob, Anim.Fast, { Size = UDim2.fromOffset(knobBase(), knobBase()) })
		tween(knobHalo, Anim.Fast, { Transparency = 1 })
		tween(valueLabel, Anim.Fast, { TextColor3 = Theme.SubText })
	end

	hit.InputBegan:Connect(function(input)
		if dragging or not isPointer(input) then
			return
		end
		dragging = true
		self._page.ScrollingEnabled = false
		tween(knob, Anim.Fast, { Size = UDim2.fromOffset(knobBase() + 4, knobBase() + 4) })
		tween(knobHalo, Anim.Fast, { Transparency = 0.6 })
		tween(valueLabel, Anim.Fast, { TextColor3 = accentLight() })
		updateFromInput(input)
	end)

	table.insert(self._connections, UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			updateFromInput(input)
		end
	end))

	table.insert(self._connections, UserInputService.InputEnded:Connect(function(input)
		if dragging and isPointer(input) then
			stopDragging()
		end
	end))

	return object
end

function Tab:AddColorPicker(config)
	config = config or {}
	local win = self._window
	local m = self._metrics
	local colors = config.Colors or DefaultSwatches
	local value = nil
	if typeof(config.Default) == "Color3" then
		value = config.Default
	end

	local holder = create("Frame", {
		Name = "ColorPicker",
		LayoutOrder = self:_nextOrder(),
		Size = UDim2.new(1, 0, 0, m.Row + 14),
		BackgroundColor3 = Theme.Element,
		Parent = self._page,
	})
	addCorner(holder, 10)
	addStroke(holder, Theme.Stroke, 0.35, 1)

	local lead = createIcon(config.Icon or "palette", holder, m.Icon, Theme.SubText)
	if lead then
		lead.Instance.AnchorPoint = Vector2.new(0, 0.5)
		lead.Instance.Position = UDim2.new(0, 14, 0, 17)
	end

	local nameLabel = create("TextLabel", {
		Name = "Label",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(14, 8),
		Size = UDim2.new(1, -28, 0, 18),
		Text = config.Name or "Cor",
		Font = Theme.Font,
		TextSize = m.Text,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = holder,
	})

	local swatchHolder = create("Frame", {
		Name = "Swatches",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(14, 34),
		Size = UDim2.new(1, -28, 0, 0),
		Parent = holder,
	})
	local grid = create("UIGridLayout", {
		CellSize = UDim2.fromOffset(m.Swatch, m.Swatch),
		CellPadding = UDim2.fromOffset(8, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = swatchHolder,
	})

	local swatches = {}

	local function resize()
		local content = grid.AbsoluteContentSize.Y
		swatchHolder.Size = UDim2.new(1, -28, 0, content)
		holder.Size = UDim2.new(1, 0, 0, 34 + content + 12)
	end
	grid:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(resize)

	local function paintSelection(animate)
		for _, entry in ipairs(swatches) do
			local selected = value ~= nil and colorsEqual(entry.Color, value)
			setProps(entry.Stroke, { Transparency = selected and 0 or 1 }, animate, Anim.Fast)
			if selected and animate and not entry.Selected then
				entry.Scale.Scale = 0.82
				tween(entry.Scale, Anim.Normal, { Scale = 1 }, Enum.EasingStyle.Back)
			end
			entry.Selected = selected
		end
	end

	local object = { Instance = holder }

	function object:Set(color, silent)
		if typeof(color) ~= "Color3" then
			return
		end
		value = color
		paintSelection(true)
		if not silent then
			safeCall(config.Callback, value)
		end
	end

	function object:Get()
		return value
	end

	for index, color in ipairs(colors) do
		local swatch = create("TextButton", {
			Name = "Swatch" .. tostring(index),
			LayoutOrder = index,
			BackgroundColor3 = color,
			AutoButtonColor = false,
			Text = "",
			Parent = swatchHolder,
		})
		addCornerScale(swatch, 0.5)
		local swatchStroke = create("UIStroke", {
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
			Color = Theme.White,
			Thickness = 2,
			Transparency = 1,
			Parent = swatch,
		})
		local swatchScale = create("UIScale", { Parent = swatch })
		swatch.MouseEnter:Connect(function()
			tween(swatchScale, Anim.Fast, { Scale = 1.1 })
		end)
		swatch.MouseLeave:Connect(function()
			tween(swatchScale, Anim.Fast, { Scale = 1 })
		end)
		swatch.Activated:Connect(function()
			object:Set(color)
		end)
		table.insert(swatches, { Color = color, Stroke = swatchStroke, Scale = swatchScale, Selected = false })
	end

	win:_onLayout(function()
		nameLabel.TextSize = m.Text
		local leftX = 14
		if lead then
			lead:SetSize(m.Icon)
			leftX = 14 + m.Icon + 10
		end
		nameLabel.Position = UDim2.fromOffset(leftX, 8)
		nameLabel.Size = UDim2.new(1, -(leftX + 14), 0, 18)
		grid.CellSize = UDim2.fromOffset(m.Swatch, m.Swatch)
		resize()
	end)

	paintSelection(false)

	return object
end

function Tab:_applyMetrics()
	local m = self._metrics
	self._label.TextSize = m.Text
	self._label.Position = UDim2.fromOffset(m.SideRow, 0)
	self._label.Size = UDim2.new(1, -m.SideRow, 1, 0)
	if self._icon then
		self._icon:SetSize(m.Icon)
		self._icon.Instance.Position = UDim2.new(0, math.floor((m.SideRow - m.Icon) / 2), 0.5, 0)
	end
	self._pagePadding.PaddingLeft = UDim.new(0, m.Pad)
	self._pagePadding.PaddingTop = UDim.new(0, m.Pad)
	self._pagePadding.PaddingRight = UDim.new(0, m.Pad)
	self._pagePadding.PaddingBottom = UDim.new(0, m.Pad)
	self._pageLayout.Padding = UDim.new(0, m.Gap)
	self:_refresh()
end

function Tab:_paint(animate)
	local selected = self._window._selectedTab == self
	local hovering = self._hover == true and not selected
	local textColor = (selected or hovering) and Theme.Text or Theme.SubText
	local iconColor = selected and accentLight() or (hovering and Theme.Text or Theme.SubText)
	local backgroundTransparency = hovering and 0.55 or 1
	if animate then
		tween(self._button, Anim.Fast, { BackgroundTransparency = backgroundTransparency })
		tween(self._label, Anim.Fast, { TextColor3 = textColor })
		if self._icon then
			self._icon:Tween(iconColor, Anim.Fast)
		end
	else
		self._button.BackgroundTransparency = backgroundTransparency
		self._label.TextColor3 = textColor
		if self._icon then
			self._icon:SetColor(iconColor)
		end
	end
end

function Tab:_applyCollapse(collapsed, animate)
	local label = self._label
	self._collapsed = collapsed
	if collapsed then
		if animate then
			local t = tween(label, Anim.Fast, { TextTransparency = 1 })
			t.Completed:Connect(function()
				if self._collapsed then
					label.Visible = false
				end
			end)
		else
			label.TextTransparency = 1
			label.Visible = false
		end
	else
		label.Visible = true
		if animate then
			label.TextTransparency = 1
			tween(label, Anim.Normal, { TextTransparency = 0 })
		else
			label.TextTransparency = 0
		end
	end
end

