-- Componentes (metodos de Tab)
----------------------------------------------------------------
function Tab:_nextOrder()
	self._order = self._order + 1
	return self._order
end

function Tab:_refresh()
	if self._updateCanvas then
		self._updateCanvas()
	end
end

function Tab:AddSection(text)
	local m = self._metrics

	local holder = create("Frame", {
		Name = "Section",
		LayoutOrder = self:_nextOrder(),
		Size = UDim2.new(1, 0, 0, 22),
		BackgroundTransparency = 1,
		Parent = self._page,
	})

	local label = create("TextLabel", {
		Name = "Label",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 1, 0),
		Text = string.upper(tostring(text or "Section")),
		Font = Theme.FontBold,
		TextSize = m.Text - 2,
		TextColor3 = Theme.SubText,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = holder,
	})
	addPadding(label, 4, 0, 0, 0)

	local object = { Instance = holder }

	function object:SetText(newText)
		label.Text = string.upper(tostring(newText))
	end

	return object
end

function Tab:AddLabel(config)
	if typeof(config) == "string" then
		config = { Text = config }
	end
	config = config or {}
	local m = self._metrics

	local label = create("TextLabel", {
		Name = "Label",
		LayoutOrder = self:_nextOrder(),
		Size = UDim2.new(1, 0, 0, m.Row - 4),
		BackgroundColor3 = Theme.Surface,
		Text = tostring(config.Text or config.Name or "Label"),
		Font = Theme.Font,
		TextSize = m.Text,
		TextColor3 = Theme.SubText,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = self._page,
	})
	addCorner(label, 8)
	addPadding(label, 12, 0, 12, 0)
	addStroke(label, Theme.Stroke, 0.6, 1)

	local object = { Instance = label }

	function object:SetText(newText)
		label.Text = tostring(newText)
	end

	return object
end

function Tab:AddButton(config)
	config = config or {}
	local m = self._metrics

	local button = create("TextButton", {
		Name = "Button",
		LayoutOrder = self:_nextOrder(),
		Size = UDim2.new(1, 0, 0, m.Row),
		BackgroundColor3 = Theme.Element,
		AutoButtonColor = false,
		Text = config.Name or "Button",
		Font = Theme.Font,
		TextSize = m.Text,
		TextColor3 = Theme.Text,
		Parent = self._page,
	})
	addCorner(button, 8)
	local stroke = addStroke(button, Theme.Stroke, 0.5, 1)
	local scale = create("UIScale", { Parent = button })

	local hovering = false
	button.MouseEnter:Connect(function()
		hovering = true
		tween(button, Anim.Fast, { BackgroundColor3 = Theme.ElementHover })
		tween(stroke, Anim.Fast, { Color = Theme.Accent, Transparency = 0.2 })
	end)
	button.MouseLeave:Connect(function()
		hovering = false
		tween(button, Anim.Fast, { BackgroundColor3 = Theme.Element })
		tween(stroke, Anim.Fast, { Color = Theme.Stroke, Transparency = 0.5 })
		tween(scale, Anim.Fast, { Scale = 1 })
	end)
	button.MouseButton1Down:Connect(function()
		tween(button, 0.08, { BackgroundColor3 = Theme.Accent })
		tween(scale, 0.08, { Scale = 0.97 })
	end)
	button.MouseButton1Up:Connect(function()
		tween(button, Anim.Fast, { BackgroundColor3 = hovering and Theme.ElementHover or Theme.Element })
		tween(scale, Anim.Fast, { Scale = 1 }, Enum.EasingStyle.Back)
	end)
	button.Activated:Connect(function()
		safeCall(config.Callback)
	end)

	local object = { Instance = button }

	function object:SetText(newText)
		button.Text = tostring(newText)
	end

	return object
end

function Tab:AddToggle(config)
	config = config or {}
	local m = self._metrics
	local state = config.Default == true

	local row = create("TextButton", {
		Name = "Toggle",
		LayoutOrder = self:_nextOrder(),
		Size = UDim2.new(1, 0, 0, m.Row),
		BackgroundColor3 = Theme.Element,
		AutoButtonColor = false,
		Text = "",
		Parent = self._page,
	})
	addCorner(row, 8)
	local stroke = addStroke(row, Theme.Stroke, 0.5, 1)

	create("TextLabel", {
		Name = "Label",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(12, 0),
		Size = UDim2.new(1, -70, 1, 0),
		Text = config.Name or "Toggle",
		Font = Theme.Font,
		TextSize = m.Text,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = row,
	})

	local switch = create("Frame", {
		Name = "Switch",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.fromOffset(40, 22),
		BackgroundColor3 = state and Theme.Accent or Theme.Off,
		Parent = row,
	})
	create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = switch })

	local knob = create("Frame", {
		Name = "Knob",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = state and UDim2.new(1, -19, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
		Size = UDim2.fromOffset(16, 16),
		BackgroundColor3 = Theme.White,
		Parent = switch,
	})
	create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = knob })

	local object = { Instance = row }

	local function render()
		tween(switch, Anim.Normal, { BackgroundColor3 = state and Theme.Accent or Theme.Off })
		tween(knob, Anim.Normal, {
			Position = state and UDim2.new(1, -19, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
		}, Enum.EasingStyle.Back)
		tween(stroke, Anim.Normal, {
			Color = state and Theme.Accent or Theme.Stroke,
			Transparency = state and 0.35 or 0.5,
		})
	end

	if state then
		stroke.Color = Theme.Accent
		stroke.Transparency = 0.35
	end

	function object:Set(value)
		value = value == true
		if value == state then
			return
		end
		state = value
		render()
		safeCall(config.Callback, state)
	end

	function object:Get()
		return state
	end

	row.MouseEnter:Connect(function()
		tween(row, Anim.Fast, { BackgroundColor3 = Theme.ElementHover })
	end)
	row.MouseLeave:Connect(function()
		tween(row, Anim.Fast, { BackgroundColor3 = Theme.Element })
	end)
	row.Activated:Connect(function()
		object:Set(not state)
	end)

	return object
end

function Tab:AddSlider(config)
	config = config or {}
	local m = self._metrics
	local min = config.Min or 0
	local max = config.Max or 100
	if max < min then
		min, max = max, min
	end
	local step = config.Step or 1
	local suffix = config.Suffix or ""
	local holderHeight = m.Row + 16

	local function snap(v)
		v = math.clamp(v, min, max)
		if step > 0 then
			v = min + math.floor((v - min) / step + 0.5) * step
		end
		v = math.clamp(v, min, max)
		return math.floor(v * 10000 + 0.5) / 10000
	end

	local value = snap(config.Default or min)

	local holder = create("Frame", {
		Name = "Slider",
		LayoutOrder = self:_nextOrder(),
		Size = UDim2.new(1, 0, 0, holderHeight),
		BackgroundColor3 = Theme.Element,
		Parent = self._page,
	})
	addCorner(holder, 8)
	addStroke(holder, Theme.Stroke, 0.5, 1)

	create("TextLabel", {
		Name = "Label",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(12, 8),
		Size = UDim2.new(1, -90, 0, 18),
		Text = config.Name or "Slider",
		Font = Theme.Font,
		TextSize = m.Text,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = holder,
	})

	local valueLabel = create("TextLabel", {
		Name = "Value",
		AnchorPoint = Vector2.new(1, 0),
		BackgroundTransparency = 1,
		Position = UDim2.new(1, -12, 0, 8),
		Size = UDim2.fromOffset(70, 18),
		Text = "",
		Font = Theme.Font,
		TextSize = m.Text,
		TextColor3 = Theme.SubText,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = holder,
	})

	local track = create("Frame", {
		Name = "Track",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 1, -18),
		Size = UDim2.new(1, -24, 0, 6),
		BackgroundColor3 = Theme.Off,
		Parent = holder,
	})
	create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = track })

	local fill = create("Frame", {
		Name = "Fill",
		Size = UDim2.new(0, 0, 1, 0),
		BackgroundColor3 = Theme.White,
		Parent = track,
	})
	create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = fill })
	create("UIGradient", {
		Color = ColorSequence.new(Theme.Accent, Theme.AccentLight),
		Parent = fill,
	})

	local knob = create("Frame", {
		Name = "Knob",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.fromOffset(14, 14),
		BackgroundColor3 = Theme.White,
		ZIndex = 2,
		Parent = track,
	})
	create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = knob })
	addStroke(knob, Theme.Accent, 0.4, 2)

	-- Area de toque ampliada (facilita o uso no celular).
	local hit = create("TextButton", {
		Name = "Hit",
		AnchorPoint = Vector2.new(0, 1),
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, 34),
		Text = "",
		AutoButtonColor = false,
		ZIndex = 3,
		Parent = holder,
	})

	local function render(animate)
		local alpha = 0
		if max > min then
			alpha = (value - min) / (max - min)
		end
		valueLabel.Text = tostring(value) .. suffix
		if animate then
			tween(fill, 0.06, { Size = UDim2.new(alpha, 0, 1, 0) }, Enum.EasingStyle.Linear)
			tween(knob, 0.06, { Position = UDim2.new(alpha, 0, 0.5, 0) }, Enum.EasingStyle.Linear)
		else
			fill.Size = UDim2.new(alpha, 0, 1, 0)
			knob.Position = UDim2.new(alpha, 0, 0.5, 0)
		end
	end
	render(false)

	local object = { Instance = holder }

	function object:Set(newValue)
		newValue = snap(newValue)
		if newValue == value then
			return
		end
		value = newValue
		render(true)
		safeCall(config.Callback, value)
	end

	function object:Get()
		return value
	end

	local dragging = false

	local function updateFromInput(input)
		local width = track.AbsoluteSize.X
		if width <= 0 then
			return
		end
		local alpha = math.clamp((input.Position.X - track.AbsolutePosition.X) / width, 0, 1)
		object:Set(min + (max - min) * alpha)
	end

	local function stopDragging()
		if not dragging then
			return
		end
		dragging = false
		self._page.ScrollingEnabled = true
		tween(knob, Anim.Fast, { Size = UDim2.fromOffset(14, 14) })
		tween(valueLabel, Anim.Fast, { TextColor3 = Theme.SubText })
	end

	hit.InputBegan:Connect(function(input)
		if dragging or not isPointer(input) then
			return
		end
		dragging = true
		self._page.ScrollingEnabled = false
		tween(knob, Anim.Fast, { Size = UDim2.fromOffset(18, 18) })
		tween(valueLabel, Anim.Fast, { TextColor3 = Theme.AccentLight })
		updateFromInput(input)
	end)

	table.insert(self._connections, UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			updateFromInput(input)
		end
	end))

	table.insert(self._connections, UserInputService.InputEnded:Connect(function(input)
		if dragging and isPointer(input) then
			stopDragging()
		end
	end))

	return object
end

