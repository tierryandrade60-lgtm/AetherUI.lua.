function Window:_showBall()
	self._ball.Visible = true
	self._ballScale.Scale = 0
	tween(self._ballScale, Anim.Normal + 0.05, { Scale = 1 }, Enum.EasingStyle.Back)

	if self._pulse then
		self._pulse:Cancel()
		self._pulse = nil
	end
	if State.LowPerformance then
		self._ballStroke.Transparency = 0.35
		return
	end
	self._ballStroke.Transparency = 0.7
	self._pulse = TweenService:Create(
		self._ballStroke,
		TweenInfo.new(1.1, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
		{ Transparency = 0.2 }
	)
	self._pulse:Play()
end

function Window:Minimize()
	if self._state ~= "Open" and self._state ~= "Opening" then
		return
	end
	self._state = "Minimizing"
	local root = self._root
	self._restorePosition = root.Position

	local duration = Anim.Normal + 0.1
	tween(root, duration, {
		Position = self._ball.Position,
		GroupTransparency = 1,
	}, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
	local t = tween(self._scale, duration, { Scale = 0.1 }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
	t.Completed:Connect(function(playbackState)
		if playbackState ~= Enum.PlaybackState.Completed or self._state ~= "Minimizing" then
			return
		end
		root.Visible = false
		self._state = "Minimized"
		self:_showBall()
	end)
end

function Window:Restore()
	if self._state ~= "Minimized" then
		return
	end
	self._state = "Restoring"
	local root = self._root
	local ballPosition = self._ball.Position

	if self._pulse then
		self._pulse:Cancel()
		self._pulse = nil
	end

	local t = tween(self._ballScale, Anim.Fast, { Scale = 0 }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
	t.Completed:Connect(function(playbackState)
		if playbackState ~= Enum.PlaybackState.Completed or self._state ~= "Restoring" then
			return
		end
		self._ball.Visible = false

		local size = self:_getSize()
		root.Size = size
		root.Position = ballPosition
		root.GroupTransparency = 1
		self._scale.Scale = 0.1
		root.Visible = true
		self:_applyLayout(false)

		tween(root, Anim.Slow, {
			Position = clampWindowPosition(self._restorePosition, size),
			GroupTransparency = 0,
		})
		local t2 = tween(self._scale, Anim.Slow, { Scale = 1 })
		t2.Completed:Connect(function(state2)
			if state2 == Enum.PlaybackState.Completed and self._state == "Restoring" then
				self._state = "Open"
			end
		end)
	end)
end

function Window:Close()
	if self._state == "Closing" or self._state == "Destroyed" then
		return
	end
	local wasHidden = not self._root.Visible
	self._state = "Closing"
	safeCall(self._onClose)

	if wasHidden then
		self:Destroy()
		return
	end

	tween(self._root, Anim.Normal, { GroupTransparency = 1 }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
	local t = tween(self._scale, Anim.Normal, { Scale = 0.94 }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
	t.Completed:Connect(function()
		self:Destroy()
	end)
end

function Window:Destroy()
	if self._state == "Destroyed" then
		return
	end
	self._state = "Destroyed"
	for index, window in ipairs(Windows) do
		if window == self then
			table.remove(Windows, index)
			break
		end
	end
	for _, connection in ipairs(self._connections) do
		connection:Disconnect()
	end
	table.clear(self._connections)
	if self._cameraConnection then
		self._cameraConnection:Disconnect()
		self._cameraConnection = nil
	end
	if self._pulse then
		self._pulse:Cancel()
		self._pulse = nil
	end
	if self._gui then
		self._gui:Destroy()
	end
end

function Window:_onViewportChanged()
	if self._state == "Destroyed" then
		return
	end
	if self._state == "Open" then
		self:_resize(true)
	end
	self._ball.Position = clampBallPosition(self._ball.Position, self._metrics.Ball)
end

function Window:_bindCamera()
	if self._cameraConnection then
		self._cameraConnection:Disconnect()
		self._cameraConnection = nil
	end
	local camera = workspace.CurrentCamera
	if camera then
		self._cameraConnection = camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
			self:_onViewportChanged()
		end)
	end
end

