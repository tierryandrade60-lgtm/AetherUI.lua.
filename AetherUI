end

function Window:_buildSettings()
	local tab = self:_createTab("Interface", "settings", true)
	self._settingsTab = tab
	self:_layoutSidebar()
	self:_moveIndicator(false)

	local sliderR
	local sliderG
	local sliderB
	local picker

	local function syncAccent()
		if not picker then
			return
		end
		local color = State.Accent
		picker:Set(color, true)
		sliderR:Set(math.floor(color.R * 255 + 0.5))
		sliderG:Set(math.floor(color.G * 255 + 0.5))
		sliderB:Set(math.floor(color.B * 255 + 0.5))
	end

	local function fromSliders()
		if self._syncing then
			return
		end
		AetherUI.SetAccent(Color3.fromRGB(sliderR:Get(), sliderG:Get(), sliderB:Get()))
	end

	tab:AddSection({ Text = "Aparencia", Icon = "palette" })

	picker = tab:AddColorPicker({
		Name = "Cor de destaque",
		Default = State.Accent,
		Callback = function(color)
			if self._syncing then
				return
			end
			AetherUI.SetAccent(color)
		end,
	})

	sliderR = tab:AddSlider({
		Name = "Vermelho",
		Min = 0,
		Max = 255,
		Default = math.floor(State.Accent.R * 255 + 0.5),
		Step = 1,
		Callback = fromSliders,
	})
	sliderG = tab:AddSlider({
		Name = "Verde",
		Min = 0,
		Max = 255,
		Default = math.floor(State.Accent.G * 255 + 0.5),
		Step = 1,
		Callback = fromSliders,
	})
	sliderB = tab:AddSlider({
		Name = "Azul",
		Min = 0,
		Max = 255,
		Default = math.floor(State.Accent.B * 255 + 0.5),
		Step = 1,
		Callback = fromSliders,
	})

	tab:AddSection({ Text = "Interface", Icon = "gauge" })

	local toggleCompact = tab:AddToggle({
		Name = "Modo compacto",
		Icon = "maximize",
		Default = self._compact,
		Callback = function(value)
			if self._syncing then
				return
			end
			self:SetCompact(value)
		end,
	})

	local toggleSidebar = tab:AddToggle({
		Name = "Sidebar so com icones",
		Icon = "menu",
		Default = self._collapsed == true,
		Callback = function(value)
			if self._syncing then
				return
			end
			self:SetSidebarCollapsed(value)
		end,
	})

	local toggleLow = tab:AddToggle({
		Name = "Modo baixo desempenho",
		Icon = "bolt",
		Default = State.LowPerformance,
		Callback = function(value)
			if self._syncing then
				return
			end
			AetherUI.SetLowPerformance(value)
		end,
	})

	self._settingsControls = {
		Compact = toggleCompact,
		Sidebar = toggleSidebar,
		LowPerformance = toggleLow,
		SyncAccent = syncAccent,
	}
end

